# ─── Required ───────────────────────────────────────────────────────────────
# Get this from Neon dashboard (https://neon.tech)
DATABASE_URL=postgresql://username:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── Optional – Receipt file storage ────────────────────────────────────────
# Sign up free at https://cloudinary.com (25 GB free, no credit card)
# If these are left empty, receipts save to local disk (only for local dev).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
